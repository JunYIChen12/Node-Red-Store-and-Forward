[
  {
    "id": "tab_store_forward",
    "type": "tab",
    "label": "Store and Forward",
    "disabled": false,
    "info": "MQTT to SQLite store-and-forward with small memory footprint"
  },
  {
    "id": "sqlite_db",
    "type": "sqlitedb",
    "db": "${DB_PATH:-/data/store-and-forward.db}",
    "mode": "RWC",
    "name": "Edge SQLite"
  },
  {
    "id": "modbus_client",
    "type": "modbus-client",
    "name": "PLC Modbus",
    "clienttype": "tcp",
    "bufferCommands": true,
    "stateLogEnabled": false,
    "tcpHost": "${PLC_HOST:-192.168.1.10}",
    "tcpPort": "502",
    "unit_id": "1",
    "tcpTimeout": "2000",
    "tcpType": "DEFAULT"
  },
  {
    "id": "mqtt_broker",
    "type": "mqtt-broker",
    "name": "Edge MQTT",
    "broker": "${MQTT_HOST:-localhost}",
    "port": "${MQTT_PORT:-1883}",
    "clientid": "store-forward",
    "usetls": false,
    "compatmode": true,
    "keepalive": "60",
    "cleansession": true,
    "protocolVersion": "4",
    "autoConnect": true
  },
  {
    "id": "modbus_read",
    "type": "modbus-read",
    "z": "tab_store_forward",
    "name": "PLC Modbus Read",
    "topic": "",
    "showStatusActivities": false,
    "logIOActivities": false,
    "showErrors": false,
    "unitid": "1",
    "dataType": "HoldingRegister",
    "adr": "0",
    "quantity": "10",
    "rate": "1000",
    "rateUnit": "ms",
    "delayOnStart": false,
    "startDelayTime": "",
    "server": "modbus_client",
    "useIOFile": false,
    "ioFile": "",
    "useIOForPayload": false,
    "emptyMsgOnFail": true,
    "keepMsgProperties": false,
    "x": 160,
    "y": 100,
    "wires": [["fn_normalize"], ["debug_errors"]]
  },
  {
    "id": "fn_normalize",
    "type": "function",
    "z": "tab_store_forward",
    "name": "Normalize & buffer",
    "func": "const payload = typeof msg.payload === 'string' ? msg.payload : JSON.stringify(msg.payload);\nconst now = Date.now();\nconst qos = msg.qos ?? 1;\nconst topic = msg.topic || flow.get('defaultTopic') || 'plc/data';\nmsg.topic = \"INSERT INTO message_queue (topic, payload, qos, ts, status, retries) VALUES (?, ?, ?, ?, 'pending', 0)\";\nmsg.params = [topic, payload, qos, now];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 100,
    "wires": [["sqlite_insert"]]
  },
  {
    "id": "sqlite_insert",
    "type": "sqlite",
    "z": "tab_store_forward",
    "mydb": "sqlite_db",
    "name": "Persist message",
    "outputs": 0,
    "x": 640,
    "y": 100,
    "wires": []
  },
  {
    "id": "inject_poll",
    "type": "inject",
    "z": "tab_store_forward",
    "name": "Poll pending",
    "props": [
      { "p": "payload" }
    ],
    "repeat": "${RETRY_SECONDS:-5}",
    "once": true,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 140,
    "y": 200,
    "wires": [["fn_query_pending"]]
  },
  {
    "id": "fn_query_pending",
    "type": "function",
    "z": "tab_store_forward",
    "name": "Query batch",
    "func": "const limit = parseInt(env.get('BATCH_LIMIT') || flow.get('batchLimit') || 10, 10);\nmsg.topic = \"SELECT id, topic, payload, qos FROM message_queue WHERE status='pending' ORDER BY id ASC LIMIT ?\";\nmsg.params = [limit];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 200,
    "wires": [["sqlite_select"]]
  },
  {
    "id": "sqlite_select",
    "type": "sqlite",
    "z": "tab_store_forward",
    "mydb": "sqlite_db",
    "name": "Load pending",
    "outputs": 1,
    "x": 580,
    "y": 200,
    "wires": [["split_rows"]]
  },
  {
    "id": "split_rows",
    "type": "split",
    "z": "tab_store_forward",
    "name": "One message at a time",
    "splt": "\n",
    "spltType": "str",
    "arraySplt": 1,
    "stream": false,
    "addname": "",
    "x": 810,
    "y": 200,
    "wires": [["fn_prepare_publish"]]
  },
  {
    "id": "fn_prepare_publish",
    "type": "function",
    "z": "tab_store_forward",
    "name": "To MQTT",
    "func": "if (!msg.payload) { return null; }\nconst row = msg.payload;\nmsg.queueId = row.id;\nmsg.topic = row.topic;\ntry {\n    msg.payload = JSON.parse(row.payload);\n} catch (err) {\n    msg.payload = row.payload;\n}\nmsg.qos = row.qos || 1;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1030,
    "y": 200,
    "wires": [["mqtt_out", "fn_mark_sent"]]
  },
  {
    "id": "mqtt_out",
    "type": "mqtt out",
    "z": "tab_store_forward",
    "name": "Forward to broker",
    "topic": "",
    "qos": "",
    "retain": "",
    "broker": "mqtt_broker",
    "x": 1280,
    "y": 180,
    "wires": []
  },
  {
    "id": "fn_mark_sent",
    "type": "function",
    "z": "tab_store_forward",
    "name": "Mark sent",
    "func": "if (!msg.queueId) { return null; }\nmsg.topic = \"UPDATE message_queue SET status='sent', sent_at = ? WHERE id = ?\";\nmsg.params = [Date.now(), msg.queueId];\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1290,
    "y": 230,
    "wires": [["sqlite_update"]]
  },
  {
    "id": "sqlite_update",
    "type": "sqlite",
    "z": "tab_store_forward",
    "mydb": "sqlite_db",
    "name": "Persist status",
    "outputs": 0,
    "x": 1500,
    "y": 230,
    "wires": []
  },
  {
    "id": "catch_all",
    "type": "catch",
    "z": "tab_store_forward",
    "name": "Catch errors",
    "scope": null,
    "uncaught": false,
    "x": 170,
    "y": 300,
    "wires": [["debug_errors"]]
  },
  {
    "id": "debug_errors",
    "type": "debug",
    "z": "tab_store_forward",
    "name": "Debug/Log",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "true",
    "targetType": "full",
    "statusVal": "",
    "statusType": "auto",
    "x": 380,
    "y": 300,
    "wires": []
  }
]
