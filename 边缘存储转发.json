    {
        "id": "e9c49a41cc30163d",
        "type": "function",
        "z": "00ed9b2795036d55",
        "name": "格式化发送 (带时间戳)",
        "func": "if (!msg.payload) { return null; }\n\nconst row = msg.payload;\n// 保留 row.id 以便后续更新状态\nmsg.queueId = row.id;\n\n// 恢复 MQTT Topic\nmsg.topic = row.topic;\n\n// 解析原始数值\nlet rawValue;\ntry {\n    rawValue = JSON.parse(row.payload);\n} catch (err) {\n    rawValue = row.payload;\n}\n\n// --- 构建最终 JSON 包 ---\n// 包含原始值和数据库里存储的北京时间\nmsg.payload = {\n    value: rawValue,\n    ts: row.ts \n};\n\nmsg.qos = row.qos || 1;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1020,
        "y": 280,
