    {
        "id": "7d96c48ab5f69257",
        "type": "function",
        "z": "00ed9b2795036d55",
        "name": "② 构建查询 (含断网熔断)",
        "func": "// --- 1. 断网熔断机制 ---\nconst isConnected = flow.get('mqttConnected');\n\nif (isConnected !== true) {\n    node.status({fill:\"red\", shape:\"ring\", text:\"等待MQTT连接...\"});\n    return null;\n}\n\nnode.status({fill:\"green\", shape:\"dot\", text:\"正在轮询\"});\n\n// --- 2. 构建查询 ---\nconst limit = 10;\n// 按ID顺序取出未发送的数据\nmsg.topic = `SELECT id, topic, payload, qos, ts FROM message_queue WHERE status='pending' ORDER BY id ASC LIMIT ${limit}`;\nmsg.params = [];\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 280,
