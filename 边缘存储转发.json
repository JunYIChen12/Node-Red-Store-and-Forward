    {
        "id": "c39071a5568ff0eb",
        "type": "function",
        "z": "00ed9b2795036d55",
        "name": "① 清洗 & 组装 (北京时间)",
        "func": "// --- 1. 防御性拦截 ---\nif (msg.payload === \"\" || msg.payload == null || msg.error) {\n    return null;\n}\n\n// --- 2. 数据准备 ---\nconst payloadStr = typeof msg.payload === 'string' ? msg.payload : JSON.stringify(msg.payload);\nconst qos = msg.qos || 1;\nconst topicStr = msg.topic || 'plc/default';\n\n// --- 3. 生成北京时间 (YYYY-MM-DD HH:mm:ss) ---\nconst d = new Date();\n// UTC时间 + 8小时偏移量\nconst beijingMs = d.getTime() + (8 * 60 * 60 * 1000);\nconst beijingDate = new Date(beijingMs);\n// 转ISO并去掉T和Z，截取前19位: \"2025-12-19 14:30:00\"\nconst now = beijingDate.toISOString().replace('T', ' ').substring(0, 19);\n\n// --- 4. 拼接 SQL ---\n// 注意：ts 字段现在是字符串，必须加单引号 '${now}'\nmsg.topic = `INSERT INTO message_queue (topic, payload, qos, ts, status, retries) \n             VALUES ('${topicStr}', '${payloadStr}', ${qos}, '${now}', 'pending', 0)`;\n\n// --- 5. 清理干扰项 ---\ndelete msg.params;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 120,
        "wires": [
            [
                "bbf99fe46aa56ac3"
            ]
        ]
    },
