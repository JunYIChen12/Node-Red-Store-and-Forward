    {
        "id": "3877f1d4e49b0a53",
        "type": "function",
        "z": "00ed9b2795036d55",
        "name": "更新状态SQL",
        "func": "if (!msg.queueId) { return null; }\n\n// 使用当前时间戳记录发送时间 (这里可以用毫秒戳，也可以用北京时间，看你需求，这里用毫秒戳方便计算耗时)\nconst now = Date.now();\nconst id = msg.queueId;\n\n// 直接拼接 SQL 更新状态\nmsg.topic = `UPDATE message_queue SET status='sent', sent_at = ${now} WHERE id = ${id}`;\n\n// 清理无关字段\ndelete msg.params;\ndelete msg.payload;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
