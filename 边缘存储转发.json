    {
        "id": "node_calc_delete",
        "type": "function",
        "z": "00ed9b2795036d55",
        "name": "1. 构建删除命令",
        "func": "const retentionDays = parseInt(env.get('RETENTION_DAYS') || 7);\n\n// 删除过期数据\nmsg.topic = `DELETE FROM message_queue WHERE status='sent' AND ts < datetime('now', '+8 hours', '-${retentionDays} days')`;\n\nnode.warn(`[维护] 正在删除 ${retentionDays} 天前的旧数据...`);\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
